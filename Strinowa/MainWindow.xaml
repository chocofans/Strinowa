<Window x:Class="StrinowaWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strinova v0.70 Beta 1"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        MinWidth="560"
        MinHeight="380"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        SizeChanged="Window_SizeChanged"
        Icon="strinowa.ico">

    <Window.Resources>

        <SolidColorBrush x:Key="BgBrush"         Color="#1A1A1F"/>
        <SolidColorBrush x:Key="TitleBarBrush"   Color="#111115"/>
        <SolidColorBrush x:Key="BorderBrush2"    Color="#2E2E38"/>
        <SolidColorBrush x:Key="AccentPink"      Color="#DC3278"/>
        <SolidColorBrush x:Key="AccentPinkDim"   Color="#8B1E5A"/>
        <SolidColorBrush x:Key="AccentPurple"    Color="#8C00C8"/>
        <SolidColorBrush x:Key="TerminalFg"      Color="#E8E8E8"/>
        <SolidColorBrush x:Key="TerminalDim"     Color="#888888"/>
        <SolidColorBrush x:Key="TerminalRelease" Color="#FF50A0"/>
        <SolidColorBrush x:Key="TerminalDev"     Color="#B42878"/>
        <SolidColorBrush x:Key="TerminalRemoved" Color="#8C1E5A"/>
        <SolidColorBrush x:Key="ChevronBrush"    Color="#DC3278"/>
        <SolidColorBrush x:Key="InputBgBrush"    Color="#13131A"/>
        <SolidColorBrush x:Key="ScrollBarBrush"  Color="#2A2A35"/>
        <Style x:Key="TitleCloseBtn" TargetType="Button">
            <Setter Property="Width"  Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="0,8,0,0">
                            <TextBlock x:Name="icon"
                                       Text="{TemplateBinding Content}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd"   Property="Background" Value="#C42B1C"/>
                                <Setter TargetName="icon" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#9E2318"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleMinBtn" TargetType="Button">
            <Setter Property="Width"  Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- colors are glitched as of 0.58.0029-->
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <TextBlock x:Name="icon"
                                       Text="{TemplateBinding Content}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd"   Property="Background" Value="#323240"/>
                                <Setter TargetName="icon" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28283A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Strinowa" TargetType="Button">
            <Setter Property="Width"  Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="About Strinowa"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#252532"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="TitleSettingsBtn" TargetType="Button">
            <Setter Property="Width"  Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Settings"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <TextBlock x:Name="icon"
                                       Text="{TemplateBinding Content}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd"   Property="Background" Value="#252532"/>
                                <Setter TargetName="icon" Property="Foreground" Value="#DC3278"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TerminalInput" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CaretBrush" Value="#DC3278"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Height="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Background="{DynamicResource ScrollThumbBrush}"
                                                        CornerRadius="3" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Height="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A3A4A"/>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThemedScrollBar}"/>

    </Window.Resources>

    <Border x:Name="OuterBorder"
            Margin="8" CornerRadius="10"
            Background="#1A1A1F"
            BorderBrush="#2E2E38"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <!-- titlebar -->
                <RowDefinition Height="1"/>
                <!-- separator -->
                <RowDefinition Height="*"/>
                <!-- terminal -->
                <RowDefinition Height="Auto"/>
                <!-- download bar -->
                <RowDefinition Height="Auto"/>
                <!-- input row -->
            </Grid.RowDefinitions>

            <Border x:Name="TitleBarBorder"
                    Grid.Row="0" CornerRadius="10,10,0,0"
                    Background="#111115"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
            Orientation="Horizontal"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="8,0,0,0">

                        <Button Style="{StaticResource Strinowa}"
            Click="LogoBtn_Click"
            Margin="0,0,5,0">
                            <Image Source="strinowa.ico"
               Width="18"
               Height="18"
               RenderOptions.BitmapScalingMode="HighQuality"
               VerticalAlignment="Center"/>
                        </Button>
                        <!-- you have to make sure to Quick Replace all version references in the project. To prevent et -->
                        <TextBlock x:Name="TitleVersionText"
               Text="Strinova v0.70 Beta 1" 
               FontFamily="Segoe UI Variable Display, Segoe UI"
               FontSize="13"
               FontWeight="SemiBold"
               Foreground="#DDDDDD"
               VerticalAlignment="Center"
               Margin="0,0,8,0"/>

                        <Button Style="{StaticResource TitleSettingsBtn}"
            Content="&#xE713;"
            Click="SettingsBtn_Click"/>

                        <!-- ? report bug button -->
                        <Button Style="{StaticResource TitleSettingsBtn}"
            x:Name="ReportBugBtn"
            Content="&#xE9CE;"
            ToolTip="Report a bug or an issue"
            Margin="2,0,0,0"
            Click="ReportBugBtn_Click"/>

                    </StackPanel>

                    <Button x:Name="MinimizeBtn" Grid.Column="1" Style="{StaticResource TitleMinBtn}"
                            Content="&#xE921;" Click="MinimizeBtn_Click"/>
                    <Button x:Name="CloseBtn" Grid.Column="2" Style="{StaticResource TitleCloseBtn}"
                            Content="&#xE8BB;" Click="CloseBtn_Click"/>
                </Grid>
            </Border>

            <Rectangle x:Name="SepRect" Grid.Row="1" Fill="#222230" Height="1"/>

            <ScrollViewer Grid.Row="2" x:Name="TermScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="14,10,8,6"
                          CanContentScroll="False">
                <RichTextBox x:Name="TerminalBox"
                             Background="Transparent"
                             Foreground="{StaticResource TerminalFg}"
                             BorderThickness="0"
                             IsReadOnly="True"
                             IsDocumentEnabled="True"
                             FontFamily="Cascadia Mono, Consolas, Courier New"
                             FontSize="13"
                             Padding="0"
                             VirtualizingPanel.IsVirtualizing="False"
                             Block.LineHeight="20">
                    <RichTextBox.Document>
                        <FlowDocument PagePadding="0" LineHeight="20"
                                      FontFamily="Cascadia Mono, Consolas, Courier New"
                                      FontSize="13"/>
                    </RichTextBox.Document>
                </RichTextBox>
            </ScrollViewer>

            <Border Grid.Row="3" x:Name="DownloadPanel"
                    Background="#0E0E16"
                    BorderBrush="#222230" BorderThickness="0,1,0,0"
                    Padding="14,10,14,10"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DlLabel"
                                   Grid.Column="0"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   FontSize="11.5"
                                   Foreground="#DC3278"
                                   Text="Downloading…"/>
                        <TextBlock x:Name="DlStats"
                                   Grid.Column="1"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   FontSize="11.5"
                                   Foreground="#888888"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,8,0"/>
                        <!-- Pause/Resume button -->
                        <Button x:Name="PauseBtn"
                                Grid.Column="2"
                                Content="&#xE769;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="11"
                                Width="26" Height="20"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#888888"
                                Cursor="Hand"
                                ToolTip="Pause"
                                Click="PauseBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <TextBlock x:Name="icon"
                                                   Text="{TemplateBinding Content}"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd"   Property="Background" Value="#252532"/>
                                            <Setter TargetName="icon" Property="Foreground" Value="#DC3278"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Border x:Name="DlTrack" Grid.Row="1" CornerRadius="4"
                            Background="#1E1E2A" Height="8">
                        <Border x:Name="DlFill" CornerRadius="4"
                                HorizontalAlignment="Left" Width="0">
                            <Border.Background>
                                <LinearGradientBrush x:Name="DlFillBrush"
                                                     StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="DlFillStop0" Color="#CCCCCC" Offset="0"/>
                                    <GradientStop x:Name="DlFillStop1" Color="#888888" Offset="0.5"/>
                                    <GradientStop x:Name="DlFillStop2" Color="#CCCCCC" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DlSubLabel"
                                   Grid.Column="0"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   FontSize="11"
                                   Foreground="#666688"/>
                        <TextBlock x:Name="DlEta"
                                   Grid.Column="1"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   FontSize="11"
                                   Foreground="#555570"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="InputRowBorder"
                    Grid.Row="4"
                    Background="#13131A"
                    BorderBrush="#222230" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10"
                    Padding="14,0,14,0" Height="40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               x:Name="ChevronBlock"
                               Text=">"
                               Foreground="{StaticResource ChevronBrush}"
                               FontFamily="Cascadia Mono, Consolas, Courier New"
                               FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">

                        <TextBlock x:Name="InputHint"
                                   Text="&lt;Game_Branch&gt;  &lt;OS|CN|PC|QQ&gt;  &lt;version&gt;  [-b | -lb]"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   FontSize="13"
                                   Foreground="#404055"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <TextBox x:Name="InputBox"
                                 Style="{StaticResource TerminalInput}"
                                 KeyDown="InputBox_KeyDown"
                                 TextChanged="InputBox_TextChanged"
                                 Background="Transparent"/>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
