<Window x:Class="StrinowaWPF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="460" Height="640"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="SettingsControlBrush" Color="#13131A"/>
        <SolidColorBrush x:Key="SettingsControlHoverBrush" Color="#333341"/>
        <SolidColorBrush x:Key="SettingsControlPressedBrush" Color="#1C1C28"/>
        <SolidColorBrush x:Key="SettingsBorderBrush" Color="#2E2E38"/>
        <SolidColorBrush x:Key="SettingsTextBrush" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="SettingsMutedBrush" Color="#888888"/>
        <SolidColorBrush x:Key="SettingsAccentBrush" Color="#DC3278"/>
        <SolidColorBrush x:Key="SettingsTrackBrush" Color="#2E2E38"/>
        <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ScrollBar}}" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SettingsCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/><Setter Property="Background" Value="{DynamicResource SettingsControlBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}"/><Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><Grid><ContentPresenter Margin="10,0,28,0" VerticalAlignment="Center" TextElement.Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ComboBox}}" Content="{Binding SelectionBoxItem,RelativeSource={RelativeSource AncestorType=ComboBox}}"/><TextBlock Text="⌄" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ComboBox}}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,2" FontSize="15"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#DC3278"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"><Border MinWidth="{Binding ActualWidth,ElementName=Toggle}" Margin="0,4,0,0" Background="{DynamicResource SettingsControlBrush}" BorderBrush="#DC3278" BorderThickness="1" CornerRadius="6"><ScrollViewer MaxHeight="160"><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/><Setter Property="Background" Value="{DynamicResource SettingsControlBrush}"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/></Style>
        <Style x:Key="SettingsCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                    Background="{DynamicResource SettingsControlBrush}"
                                    BorderBrush="{DynamicResource SettingsAccentBrush}"
                                    BorderThickness="1.5" Margin="0,0,9,0">
                                <Path x:Name="CheckMark" Data="M 1,5 L 4,8 L 10,1"
                                      Width="10" Height="8" Stretch="Fill"
                                      Stroke="{DynamicResource SettingsAccentBrush}"
                                      StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Opacity="0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SettingsControlPressedBrush}"/>
                                <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SettingsControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScaleSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource SettingsAccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource SettingsTrackBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" BorderThickness="0"
                                                  Background="{TemplateBinding Foreground}" Height="6" VerticalAlignment="Center">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="24" Margin="-6,0" Background="Transparent">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>    <Border Margin="8" CornerRadius="10"
            x:Name="RootBorder"
            Background="#1A1A1F"
            BorderBrush="#2E2E38" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="10,10,0,0"
                    x:Name="TitleBarBorder"
                    Background="#111115"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="TitleText"
                               Text="Settings"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#DDDDDD"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="46" Height="34"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#AAAAAA" Cursor="Hand"
                            Click="CloseBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                                    <TextBlock x:Name="icon" Text="&#xE8BB;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd"   Property="Background" Value="#C42B1C"/>
                                        <Setter TargetName="icon" Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Rectangle Grid.Row="1" x:Name="SepRect" Fill="#222230"/>

            <ScrollViewer x:Name="SettingsScroll" Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ScrollContent" Background="#1A1A1F" Margin="22,16,22,16">

                    <TextBlock x:Name="SectionTheme"
                               Text="LAUNCHER THEME"
                               FontFamily="Cascadia Mono, Consolas, Courier New"
                               FontSize="10" FontWeight="Bold"
                               Foreground="#DC3278" Margin="0,0,0,10"/>

                    <UniformGrid Columns="4" Margin="0,0,0,20">

                        <Border x:Name="ThemeDark" Margin="0,0,4,0" CornerRadius="8"
                                BorderThickness="2" BorderBrush="#DC3278"
                                Cursor="Hand" Height="64"
                                MouseLeftButtonDown="ThemeDark_Click">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#111115" Offset="0"/>
                                    <GradientStop Color="#1A1A1F" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="ThemeDarkLabel" Text="Dark"
                                           Foreground="#DDDDDD"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ThemeDarkSub" Text="Default"
                                           Foreground="#666688"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- this should be edited when the aurura theme is in place -->
                        <Border x:Name="ThemeMidnight" Margin="2,0,2,0" CornerRadius="8"
                                BorderThickness="2" BorderBrush="#2E2E38"
                                Cursor="Hand" Height="64"
                                MouseLeftButtonDown="ThemeMidnight_Click">
                            <Border Background="#000000" CornerRadius="7">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="ThemeMidnightLabel" Text="Midnight"
                                               Foreground="#9999BB"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ThemeMidnightSub" Text="Pure black"
                                               Foreground="#333355"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="10" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Border>

                        <Border x:Name="ThemeAcrylic" Margin="2,0,2,0" CornerRadius="8"
                                BorderThickness="2" BorderBrush="#2E2E38"
                                Cursor="Hand" Height="64"
                                MouseLeftButtonDown="ThemeAcrylic_Click">
                            <Border CornerRadius="7" BorderBrush="#72FFFFFF" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#B05A5A5A" Offset="0"/>
                                        <GradientStop Color="#90373737" Offset="0.48"/>
                                        <GradientStop Color="#A0646464" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Margin="6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="23" Height="23" VerticalAlignment="Center">
                                        <Ellipse Fill="#34FFFFFF" Stroke="#70FFFFFF" StrokeThickness="1"/>
                                        <Border Width="13" Height="13" CornerRadius="4"
                                                Background="#62E8E8E8" BorderBrush="#AAFFFFFF" BorderThickness="1"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Border Width="13" Height="13" CornerRadius="4"
                                                Background="#5AA8A8A8" BorderBrush="#80FFFFFF" BorderThickness="1"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0">
                                        <TextBlock x:Name="ThemeAcrylicLabel" Text="Acrylic"
                                                   Foreground="#F7FAFF"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ThemeAcrylicSub" Text="Blurred glass"
                                                   Foreground="#D0D0D0"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="9"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Border>

                        <!-- Light -->
                        <Border x:Name="ThemeLight" Margin="4,0,0,0" CornerRadius="8"
                                BorderThickness="2" BorderBrush="#2E2E38"
                                Cursor="Hand" Height="64"
                                MouseLeftButtonDown="ThemeLight_Click">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F0F0F5" Offset="0"/>
                                    <GradientStop Color="#E0E0EA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="ThemeLightLabel" Text="Light"
                                           Foreground="#333340"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ThemeLightSub" Text="Bright UI"
                                           Foreground="#555570"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <TextBlock x:Name="SectionTerminal"
                               Text="TERMINAL TEXT COLOR"
                               FontFamily="Cascadia Mono, Consolas, Courier New"
                               FontSize="10" FontWeight="Bold"
                               Foreground="#DC3278" Margin="0,0,0,5"/>

                    <TextBlock x:Name="TerminalColorNote"
                               Text="Text colors adapt to theme and build type."
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="11" Foreground="#666688"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <UniformGrid Columns="2" Margin="0,0,0,20">

                        <Border x:Name="TermColorA" Margin="0,0,5,0" CornerRadius="8"
                                BorderThickness="2" BorderBrush="#DC3278"
                                Cursor="Hand" Height="62"
                                MouseLeftButtonDown="TermColorA_Click">
                            <Border x:Name="TermColorAInner" Background="#13131A" CornerRadius="6">
                                <StackPanel Margin="10,10" VerticalAlignment="Center">
                                    <TextBlock x:Name="TermColorALabel"
                                               Text="Adaptive White / Black"
                                               FontFamily="Cascadia Mono, Consolas, Courier New"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#E8E8E8"/>
                                    <TextBlock x:Name="TermColorADesc"
                                               Text="An Adaptive White/Black text to match the color"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="10" Foreground="#888888"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Border>

                        <Border x:Name="TermColorB" Margin="5,0,0,0" CornerRadius="8"
                                BorderThickness="2" BorderBrush="#2E2E38"
                                Cursor="Hand" Height="62"
                                MouseLeftButtonDown="TermColorB_Click">
                            <Border x:Name="TermColorBInner" Background="#13131A" CornerRadius="6">
                                <StackPanel Margin="10,10" VerticalAlignment="Center">
                                    <TextBlock x:Name="TermColorBLabel"
                                               Text="Pink Accent"
                                               FontFamily="Cascadia Mono, Consolas, Courier New"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#FF004D"/>
                                    <TextBlock x:Name="TermColorBDesc"
                                               Text="A pretty pink gradient"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="10" Foreground="#884468"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Border>

                    </UniformGrid>

                    <!-- COLOR C: Blue/Light blue COLOR D: GRASS 
                    -->
                    <TextBlock x:Name="SectionPreview"
                               Text="PREVIEW"
                               FontFamily="Cascadia Mono, Consolas, Courier New"
                               FontSize="10" FontWeight="Bold"
                               Foreground="#DC3278" Margin="0,0,0,8"/>

                    <Border x:Name="PreviewBorder" CornerRadius="6"
                            Background="#0E0E16" BorderBrush="#222230" BorderThickness="1"
                            Margin="0,0,0,20" ClipToBounds="True">
                        <Grid x:Name="PreviewCarouselHost">
                            <Border x:Name="PreviewBackdropFallback">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#454545" Offset="0"/>
                                        <GradientStop Color="#242424" Offset="0.48"/>
                                        <GradientStop Color="#555555" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Image x:Name="PreviewBackgroundA" Stretch="UniformToFill" Opacity="0"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform><ScaleTransform ScaleX="1.08" ScaleY="1.08"/></Image.RenderTransform>
                                <Image.Effect><BlurEffect Radius="9"/></Image.Effect>
                            </Image>
                            <Image x:Name="PreviewBackgroundB" Stretch="UniformToFill" Opacity="0"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform><ScaleTransform ScaleX="1.08" ScaleY="1.08"/></Image.RenderTransform>
                                <Image.Effect><BlurEffect Radius="9"/></Image.Effect>
                            </Image>
                            <Border x:Name="PreviewAcrylicTint" Background="#302B2B2B"/>

                            <Grid Margin="12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="0"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="PreviewT1" Grid.Row="0" Grid.Column="2"
                                           Text="Text 1" FontFamily="Cascadia Mono, Consolas, Courier New"
                                           FontSize="12" Foreground="#F0F0F0" Margin="0,0,0,3"/>
                                <TextBlock x:Name="PreviewT2" Grid.Row="1" Grid.Column="2"
                                           Text="Text 2" FontFamily="Cascadia Mono, Consolas, Courier New"
                                           FontSize="12" Foreground="#BBBBBB" Margin="0,0,0,3"/>
                                <TextBlock x:Name="PreviewT3" Grid.Row="2" Grid.Column="2"
                                           Text="Text 3" FontFamily="Cascadia Mono, Consolas, Courier New"
                                           FontSize="12" Foreground="#999999" Margin="0,0,0,3"/>
                                <TextBlock x:Name="PreviewDevkit" Grid.Row="3" Grid.Column="2"
                                           Text="Devkit" FontFamily="Cascadia Mono, Consolas, Courier New"
                                           FontSize="12" Margin="0,0,0,3" Visibility="Collapsed"/>
                                <TextBlock x:Name="PreviewDeprecated" Grid.Row="4" Grid.Column="2"
                                           Text="Deprecated" FontFamily="Cascadia Mono, Consolas, Courier New"
                                           FontSize="12" Foreground="#555566" TextDecorations="Strikethrough"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="SectionLang"
                               Text="LANGUAGE"
                               FontFamily="Cascadia Mono, Consolas, Courier New"
                               FontSize="10" FontWeight="Bold"
                               Foreground="#DC3278" Margin="0,0,0,10"/>

                    <UniformGrid Columns="3" Margin="0,0,0,20">

                        <!-- English -->
                        <Border x:Name="LangEn" Margin="0,0,6,0" CornerRadius="8"
                                BorderThickness="2" BorderBrush="#DC3278"
                                Cursor="Hand" Height="48"
                                MouseLeftButtonDown="LangEn_Click">
                            <Border x:Name="LangEnInner" Background="#13131A" CornerRadius="6">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="LangEnLabel" Text="EN"
                                               FontFamily="Cascadia Mono, Consolas, Courier New"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="#E8E8E8" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LangEnSub" Text="English"
                                               FontFamily="Segoe UI" FontSize="10"
                                               Foreground="#888888" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!--cn-->
                        <Border x:Name="LangCn" Margin="3,0,3,0" CornerRadius="8"
                                BorderThickness="2" BorderBrush="#2E2E38"
                                Cursor="Hand" Height="48"
                                MouseLeftButtonDown="LangCn_Click">
                            <Border x:Name="LangCnInner" Background="#13131A" CornerRadius="6">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="LangCnLabel" Text="&#x4E2D;&#x6587;"
                                               FontFamily="Microsoft YaHei UI, Segoe UI"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="#E8E8E8" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LangCnSub" Text="Chinese"
                                               FontFamily="Segoe UI" FontSize="10"
                                               Foreground="#888888" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!--pl-->
                        <Border x:Name="LangPl" Margin="6,0,0,0" CornerRadius="8"
                                BorderThickness="2" BorderBrush="#2E2E38"
                                Cursor="Hand" Height="48"
                                MouseLeftButtonDown="LangPl_Click">
                            <Border x:Name="LangPlInner" Background="#13131A" CornerRadius="6">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="LangPlLabel" Text="PL"
                                               FontFamily="Cascadia Mono, Consolas, Courier New"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="#E8E8E8" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LangPlSub" Text="Polski"
                                               FontFamily="Segoe UI" FontSize="10"
                                               Foreground="#888888" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Border>

                    </UniformGrid>

                    <TextBlock x:Name="SectionOptions"
                               Text="OPTIONS"
                               FontFamily="Cascadia Mono, Consolas, Courier New"
                               FontSize="10" FontWeight="Bold"
                               Foreground="#DC3278" Margin="0,0,0,10"/>

                    <CheckBox x:Name="ClearLogCheck"
                              Style="{StaticResource SettingsCheckBox}"
                              Content="Clear log when download finishes"
                              Margin="2,0,0,6"/>

                    <CheckBox x:Name="SaveBruteforceCheck" Visibility="Collapsed"
                              Style="{StaticResource SettingsCheckBox}"
                              Content="Save bruteforce results to file"
                              Margin="2,0,0,6"/>

                    <TextBlock x:Name="SectionLocations"
                               Text="DOWNLOAD LOCATIONS"
                               FontFamily="Cascadia Mono, Consolas, Courier New"
                               FontSize="10" FontWeight="Bold"
                               Foreground="#DC3278" Margin="0,12,0,6"/>

                    <TextBlock x:Name="GameLocationLabel"
                               Text="GAME DOWNLOAD LOCATION"
                               FontFamily="Cascadia Mono, Consolas, Courier New"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource SettingsMutedBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="32" Padding="10,0"
                                Background="{DynamicResource SettingsControlBrush}"
                                BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1" CornerRadius="6">
                            <TextBox x:Name="GameLocationBox" Text="Game"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource SettingsTextBrush}" CaretBrush="#DC3278"
                                     FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <Button x:Name="BrowseGameLocationBtn" Grid.Column="1" Content="Browse"
                                Height="32" MinWidth="72" Margin="8,0,0,0" Padding="12,0"
                                Click="BrowseGameLocation_Click"
                                Background="{DynamicResource SettingsControlBrush}"
                                Foreground="{DynamicResource SettingsTextBrush}"
                                BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1"
                                FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="11" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SettingsControlHoverBrush}"/></Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SettingsControlPressedBrush}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="LauncherLocationLabel"
                               Text="LAUNCHER DOWNLOAD LOCATION"
                               FontFamily="Cascadia Mono, Consolas, Courier New"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource SettingsMutedBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="32" Padding="10,0"
                                Background="{DynamicResource SettingsControlBrush}"
                                BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1" CornerRadius="6">
                            <TextBox x:Name="LauncherLocationBox" Text="Launcher"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource SettingsTextBrush}" CaretBrush="#DC3278"
                                     FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <Button x:Name="BrowseLauncherLocationBtn" Grid.Column="1" Content="Browse"
                                Height="32" MinWidth="72" Margin="8,0,0,0" Padding="12,0"
                                Click="BrowseLauncherLocation_Click"
                                Background="{DynamicResource SettingsControlBrush}"
                                Foreground="{DynamicResource SettingsTextBrush}"
                                BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1"
                                FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="11" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SettingsControlHoverBrush}"/></Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SettingsControlPressedBrush}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <CheckBox x:Name="AskLocationCheck"
                              Style="{StaticResource SettingsCheckBox}"
                              Content="Ask every time where to download"
                              Margin="2,0,0,6"/>

                    <!--
                    <CheckBox x:Name="AcrylicCheck"
                              Content="Acrylic background (Win11 22H2+)"
                              FontFamily="Segoe UI Variable Display, Segoe UI"
                              FontSize="12" Foreground="#CCCCCC" Margin="2,0,0,6"/>
                    -->

                    <TextBlock x:Name="SectionSpeed"
                               Text="DOWNLOAD SPEED (KB/s)"
                               FontFamily="Cascadia Mono, Consolas, Courier New"
                               FontSize="10" FontWeight="Bold"
                               Foreground="#DC3278" Margin="0,12,0,6"/>
                    <Border Background="{DynamicResource SettingsControlBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Width="180" Height="32" HorizontalAlignment="Left"
                            Padding="10,0">
                        <TextBox x:Name="SpeedBox"
                                 Text="51200"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource SettingsTextBrush}" CaretBrush="#DC3278"
                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                 FontSize="13" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="SectionWindowSize"
                               Text="WINDOW SIZE"
                               FontFamily="Cascadia Mono, Consolas, Courier New"
                               FontSize="10" FontWeight="Bold"
                               Foreground="#DC3278" Margin="0,12,0,6"/>
                    <ComboBox x:Name="SizePresetBox" Style="{StaticResource SettingsCombo}" Width="190" Height="32" HorizontalAlignment="Left" SelectedIndex="0">
                        <ComboBoxItem Content="Compact — 760 × 460" Tag="760,460"/>
                        <ComboBoxItem Content="Default — 900 × 560" Tag="900,560"/>
                        <ComboBoxItem Content="Comfortable — 1024 × 640" Tag="1024,640"/>
                        <ComboBoxItem Content="Large — 1280 × 800" Tag="1280,800"/>
                    </ComboBox>
                    <TextBlock Text="UI SCALE" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="10" FontWeight="Bold" Foreground="#DC3278" Margin="0,12,0,6"/>
                    <Grid Width="280" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                        <Slider x:Name="UiScaleSlider" Style="{StaticResource ScaleSlider}" Minimum="50" Maximum="200" Value="100" TickFrequency="25" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="UiScaleSlider_ValueChanged"/>
                        <TextBlock x:Name="UiScaleValue" Grid.Column="1" Text="100%" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12" Foreground="{DynamicResource SettingsTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" x:Name="FooterBorder"
                    BorderBrush="#222230" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10" Background="#0E0E16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="ApplyBtn" Content="Apply"
                            Width="90" Height="28" Margin="0,0,8,0"
                            Click="ApplyBtn_Click"
                            Background="#DC3278" Foreground="White"
                            BorderThickness="0" FontFamily="Segoe UI" FontSize="12" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#C02868"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#A02050"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="CancelBtn" Content="Cancel"
                            Width="90" Height="28"
                            Click="CloseBtn_Click"
                            Background="{DynamicResource SettingsControlBrush}" Foreground="{DynamicResource SettingsTextBrush}"
                            BorderThickness="0" FontFamily="Segoe UI" FontSize="12" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SettingsControlHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SettingsControlPressedBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>







