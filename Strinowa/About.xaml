<Window x:Class="StrinowaWPF.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="480" Height="298"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"> 
    
    <!-- This was generated by claude ai. I couldnt figure out also why the footer has a giant chin but I tried
    Every simple fix in the book so.. well -->

    <Border Margin="8" CornerRadius="10"
            x:Name="RootBorder"
            Background="#1A1A1F"
            BorderBrush="#2E2E38" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.65"/>
        </Border.Effect>

        <Grid Margin="0,0,0,-1" RenderTransformOrigin="0.485,0.626">
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="1"/>
                <RowDefinition/>
                <RowDefinition Height="65"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="10,10,0,0"
                    x:Name="TitleBarBorder"
                    Background="#111115">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="About Strinowa"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="13" FontWeight="SemiBold" Foreground="#DDDDDD"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="46" Height="34"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#AAAAAA" Cursor="Hand" Click="CloseBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                                    <TextBlock x:Name="icon" Text="&#xE8BB;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd"   Property="Background" Value="#C42B1C"/>
                                        <Setter TargetName="icon" Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Rectangle Grid.Row="1" x:Name="SepRect" Fill="#222230"/>

            <!-- winver-style content -->
            <Grid Grid.Row="2" Margin="28,18,28,41">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- App icon -->
                <Border Grid.Column="0" x:Name="AppIconGlass"
                        Width="66" Height="66" CornerRadius="16"
                        BorderThickness="1" BorderBrush="Transparent"
                        Background="Transparent" Padding="5"
                        VerticalAlignment="Top" Margin="0,0,20,0">
                    <Image Source="icon.ico"
                           Width="52" Height="52"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Text block -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Height="159">
                    <TextBlock FontFamily="Cascadia Mono, Consolas, Courier New"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#DC3278" Margin="0,0,0,2">
                        Strinowa Downloader
                    </TextBlock>
                    <TextBlock x:Name="AppVersion"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,10">
                        Version 0.7.2.0629.20260714.0949
                    </TextBlock>

                    <Rectangle Height="1" Fill="#2E2E38" Margin="0,0,0,10"/>

                    <TextBlock x:Name="AppDesc"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="12" Foreground="#CCCCCC"
                               TextWrapping="Wrap" Margin="0,0,0,4">
                        Strinova / PM game client downloader and version manager.
                    </TextBlock>
                    <TextBlock x:Name="AppCredit"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="11" Foreground="#888888">
                        by Cecilia Â· zrobione dla Tosia â™¡
                    </TextBlock>
                    <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="11" Foreground="#555566" Margin="0,6,0,0">
                        This product is licensed under private use only.
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Border Grid.Row="3"
                    x:Name="FooterBorder"
                    BorderBrush="#222230" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10" Background="#0E0E16" Margin="0,24,0,0">
                <Button x:Name="OkButton" Content="OK" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,16,0"
                        Width="80" Height="28"
                        Click="CloseBtn_Click"
                        Background="#DC3278" Foreground="White"
                        BorderThickness="0" FontFamily="Segoe UI" FontSize="12" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#C02868"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#A02050"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>

