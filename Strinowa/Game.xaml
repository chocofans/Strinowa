<Window x:Class="StrinowaWPF.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="480" Height="360"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Margin="8" CornerRadius="10"
            Background="#1A1A1F"
            BorderBrush="#2E2E38" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0" Background="#111115"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <!--
                            an image placeholder is set here incase. It will be automatic to appear
                        when the game client is started in the background. That way injection to beta should be easy
                        As well as linking your own client and starting it from here /restarting too
                     
                            <Image Source="strinova_logo.png" Width="16" Height="16" Margin="0,0,6,0"
                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        -->
                        <TextBlock Text="&#xE7FC;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" Foreground="#DC3278"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Game · DLL Inject"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#DDDDDD" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="46" Height="34"
                            Background="Transparent" BorderThickness="0"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Foreground="#AAAAAA" Cursor="Hand"
                            Click="CloseBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        &#xE8BB;
                    </Button>
                </Grid>
            </Border>

            <Rectangle Grid.Row="1" Fill="#222230"/>

            <StackPanel Grid.Row="2" Margin="24,20,24,0">

                <TextBlock Text="DLL PATH"
                           FontFamily="Cascadia Mono, Consolas, Courier New"
                           FontSize="10" FontWeight="Bold"
                           Foreground="#DC3278" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#13131A"
                            BorderBrush="#2E2E38" BorderThickness="1"
                            CornerRadius="6,0,0,6" Padding="8,0">
                        <TextBox x:Name="DllPathBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#E8E8E8" CaretBrush="#DC3278"
                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                 FontSize="12" VerticalAlignment="Center"
                                 Height="32"/>
                    </Border>
                    <Button Grid.Column="1" Content="Browse"
                            Width="70" Height="32"
                            Click="BrowseDll_Click"
                            Background="#252532" Foreground="#CCCCCC"
                            BorderThickness="0"
                            FontFamily="Segoe UI" FontSize="11"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        CornerRadius="0,6,6,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#323248"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <TextBlock Text="TARGET PROCESS"
                           FontFamily="Cascadia Mono, Consolas, Courier New"
                           FontSize="10" FontWeight="Bold"
                           Foreground="#DC3278" Margin="0,0,0,6"/>
                <ComboBox x:Name="TargetProcessBox"
                          Height="32" Margin="0,0,0,4"
                          Background="#13131A" Foreground="#E8E8E8"
                          BorderBrush="#2E2E38" BorderThickness="1"
                          FontFamily="Cascadia Mono, Consolas, Courier New"
                          FontSize="12">
                    <ComboBoxItem Content="Strinova.exe"/>
                    <ComboBoxItem Content="Strinova-Win64-Shipping.exe" IsSelected="True"/>
                    <ComboBoxItem Content="Calabiyau.exe"/>
                    <ComboBoxItem Content="Calabiyau-Win64-Shipping.exe"/>
                    <ComboBoxItem Content="PMGame.exe"/>
                    <ComboBoxItem Content="PMGame-Win64-Shipping.exe"/>
                </ComboBox>
                <TextBlock Text="Select the running game process to inject into."
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="11" Foreground="#555570"
                           Margin="0,0,0,16"/>

                <TextBlock x:Name="StatusLabel"
                           Text="Ready."
                           FontFamily="Cascadia Mono, Consolas, Courier New"
                           FontSize="12" Foreground="#666688"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Row="3" BorderBrush="#222230" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10" Background="#0E0E16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Inject" Width="100" Height="28" Margin="0,0,8,0"
                            Click="InjectBtn_Click"
                            Background="#DC3278" Foreground="White"
                            BorderThickness="0"
                            FontFamily="Segoe UI" FontSize="12"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#C02868"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#A02050"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Close" Width="90" Height="28"
                            Click="CloseBtn_Click"
                            Background="#252532" Foreground="#CCCCCC"
                            BorderThickness="0"
                            FontFamily="Segoe UI" FontSize="12"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#323248"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
