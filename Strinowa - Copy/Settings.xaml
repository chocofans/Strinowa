<Window x:Class="StrinowaWPF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="440" Height="460"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Margin="8" CornerRadius="10"
            x:Name="RootBorder"
            Background="#1A1A1F"
            BorderBrush="#2E2E38" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0"
                    x:Name="TitleBarBorder"
                    Background="#111115"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Settings"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="13" FontWeight="SemiBold"
                               x:Name="TitleText"
                               Foreground="#DDDDDD"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="46" Height="34"
                            Background="Transparent" BorderThickness="0"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Foreground="#AAAAAA" Cursor="Hand"
                            Click="CloseBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        &#xE8BB;
                    </Button>
                </Grid>
            </Border>

            <Rectangle Grid.Row="1" x:Name="SepRect" Fill="#222230"/>

            <!-- Settings content -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,16,24,16">
                <StackPanel>

                    <!-- Launcher Theme -->
                    <TextBlock Text="LAUNCHER THEME"
                               FontFamily="Cascadia Mono, Consolas, Courier New"
                               FontSize="10" FontWeight="Bold"
                               x:Name="SectionTheme"
                               Foreground="#DC3278"
                               Margin="0,0,0,10"/>

                    <WrapPanel Margin="0,0,0,20">
                        <!-- Dark -->
                        <Border x:Name="ThemeDark" Margin="0,0,8,8" CornerRadius="8"
                                BorderThickness="2" BorderBrush="#DC3278"
                                Cursor="Hand" Width="118" Height="72"
                                MouseLeftButtonDown="ThemeDark_Click">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#111115" Offset="0"/>
                                    <GradientStop Color="#1A1A1F" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Dark" Foreground="#DDDDDD"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Default" Foreground="#888888"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Midnight -->
                        <Border x:Name="ThemeMidnight" Margin="0,0,8,8" CornerRadius="8"
                                BorderThickness="2" BorderBrush="#2E2E38"
                                Cursor="Hand" Width="118" Height="72"
                                MouseLeftButtonDown="ThemeMidnight_Click">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#09090E" Offset="0"/>
                                    <GradientStop Color="#0E0E16" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Midnight" Foreground="#AAAACC"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Deep black" Foreground="#555570"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Light -->
                        <Border x:Name="ThemeLight" Margin="0,0,8,8" CornerRadius="8"
                                BorderThickness="2" BorderBrush="#2E2E38"
                                Cursor="Hand" Width="118" Height="72"
                                MouseLeftButtonDown="ThemeLight_Click">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F0F0F5" Offset="0"/>
                                    <GradientStop Color="#E0E0EA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Light" Foreground="#333340"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Bright UI" Foreground="#666680"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Terminal Text Color -->
                    <TextBlock Text="TERMINAL TEXT COLOR"
                               FontFamily="Cascadia Mono, Consolas, Courier New"
                               FontSize="10" FontWeight="Bold"
                               x:Name="SectionTerminal"
                               Foreground="#DC3278"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="TerminalColorNote"
                               Text="Normal text shifts with theme. CN builds dim slightly; Devkit text uses animated color."
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="11" Foreground="#666688"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <WrapPanel Margin="0,0,0,20">
                        <!-- Preset A: White/Black adaptive -->
                        <Border x:Name="TermColorA" Margin="0,0,8,8" CornerRadius="8"
                                BorderThickness="2" BorderBrush="#DC3278"
                                Cursor="Hand" Width="178" Height="68"
                                MouseLeftButtonDown="TermColorA_Click">
                            <Border Background="#13131A" CornerRadius="6">
                                <StackPanel Margin="10,8,10,8" VerticalAlignment="Center">
                                    <TextBlock Text="Adaptive White / Black"
                                               FontFamily="Cascadia Mono, Consolas, Courier New"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#E8E8E8"/>
                                    <TextBlock Text="[Release]  [CN dim]  [DEV anim]"
                                               FontFamily="Cascadia Mono, Consolas, Courier New"
                                               FontSize="9.5" Foreground="#666688" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- Preset B: Pink accent text -->
                        <Border x:Name="TermColorB" Margin="0,0,8,8" CornerRadius="8"
                                BorderThickness="2" BorderBrush="#2E2E38"
                                Cursor="Hand" Width="178" Height="68"
                                MouseLeftButtonDown="TermColorB_Click">
                            <Border Background="#13131A" CornerRadius="6">
                                <StackPanel Margin="10,8,10,8" VerticalAlignment="Center">
                                    <TextBlock Text="Pink Accent"
                                               FontFamily="Cascadia Mono, Consolas, Courier New"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#FF50A0"/>
                                    <TextBlock Text="[Release]  [CN dim]  [DEV anim]"
                                               FontFamily="Cascadia Mono, Consolas, Courier New"
                                               FontSize="9.5" Foreground="#884468" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </WrapPanel>

                    <!-- Preview row -->
                    <TextBlock Text="PREVIEW"
                               FontFamily="Cascadia Mono, Consolas, Courier New"
                               FontSize="10" FontWeight="Bold"
                               x:Name="SectionPreview"
                               Foreground="#DC3278"
                               Margin="0,0,0,8"/>
                    <Border CornerRadius="6" Background="#0E0E16"
                            BorderBrush="#222230" BorderThickness="1"
                            Padding="12,10" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock x:Name="PreviewNormal"
                                       Text="[Normal]  Default terminal text"
                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                       FontSize="12" Foreground="#E8E8E8" Margin="0,0,0,3"/>
                            <TextBlock x:Name="PreviewCN"
                                       Text="[CN]     China-build text (dimmed)"
                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                       FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                            <TextBlock x:Name="PreviewRelease"
                                       Text="[Release] Release build tag"
                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                       FontSize="12" Foreground="#FF50A0" Margin="0,0,0,3"/>
                            <!-- Devkit preview label — color is animated in code-behind -->
                            <TextBlock x:Name="PreviewDevkit"
                                       Text="[Devkit]  Devkit build (animated)"
                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                       FontSize="12" Margin="0,0,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer buttons -->
            <Border Grid.Row="3"
                    x:Name="FooterBorder"
                    BorderBrush="#222230" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10" Background="#0E0E16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Apply" Width="90" Height="28" Margin="0,0,8,0"
                            Click="ApplyBtn_Click"
                            Background="#DC3278" Foreground="White"
                            BorderThickness="0"
                            FontFamily="Segoe UI" FontSize="12"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#C02868"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#A02050"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Cancel" Width="90" Height="28"
                            Click="CloseBtn_Click"
                            x:Name="CancelBtn"
                            Background="#252532" Foreground="#CCCCCC"
                            BorderThickness="0"
                            FontFamily="Segoe UI" FontSize="12"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#323248"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1C1C28"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
